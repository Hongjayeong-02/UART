########################################
# UART V4 Block-level MMMC
# Top : uart_v4_apb / PCLK 10 ns, UART_CLK 20.833 ns (async, D23)
########################################

set PDK_STD <PDK>/std

########## RC Corner ##########
create_rc_corner -name BEST  -T 0   -qx_tech_file $PDK_STD/stdlib/qrc/qx/qrc.tch
create_rc_corner -name WORST -T 125 -qx_tech_file $PDK_STD/stdlib/qrc/qx/qrc.tch

########## Library Set ##########
create_library_set -name FF_Min_1p10v_0c   -timing [list $PDK_STD/stdlib/timing/std_ff.lib]
create_library_set -name SS_Max_0p90v_125c -timing [list $PDK_STD/stdlib/timing/std_ss.lib]

########## Delay Corner ##########
create_delay_corner -name FF_BEST  -library_set FF_Min_1p10v_0c   -rc_corner BEST
create_delay_corner -name SS_WORST -library_set SS_Max_0p90v_125c -rc_corner WORST

########## Constraint Mode : Genus write_sdc output ##########
create_constraint_mode -name FUNC -sdc_files [list ../syn/netlist_10ns/uart_v4_apb_syn.sdc]

########## Analysis View ##########
create_analysis_view -name FUNC_FF_BEST  -constraint_mode FUNC -delay_corner FF_BEST
create_analysis_view -name FUNC_SS_WORST -constraint_mode FUNC -delay_corner SS_WORST

set_analysis_view -setup [list FUNC_SS_WORST] -hold [list FUNC_FF_BEST]
