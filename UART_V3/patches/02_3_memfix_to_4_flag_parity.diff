diff -ruN UART_V3_memfix/uart_fifo.v UART_V3/uart_fifo.v
--- UART_V3_memfix/uart_fifo.v	2026-10-21 19:57:37.000000000 +0900
+++ UART_V3/uart_fifo.v	2026-10-22 18:36:54.000000000 +0900
@@ -28,21 +28,28 @@
 
 reg     [4:0]   r_count;
 
+// Registered status flags (timing opt):
+// full/empty are pre-computed one cycle ahead instead of decoding
+// r_count every cycle, so the count compare is removed from the
+// r_count -> w_wrEn/w_rdEn -> mem enable / pointer critical path.
+reg             r_full;
+reg             r_empty;
+
 
 wire            w_wrEn;
 wire            w_rdEn;
 
 
-assign o_full  = (r_count == FIFO_DEPTH);
-assign o_empty = (r_count == 0);
+assign o_full  = r_full;
+assign o_empty = r_empty;
 assign o_count = r_count;
 
 
 assign w_wrEn = i_wrEn &&
-                !o_full;
+                !r_full;
 
 assign w_rdEn = i_rdEn &&
-                !o_empty;
+                !r_empty;
 
 // FIFO storage: no reset (separated from async-reset control logic)
 always @(posedge clk) begin
@@ -57,6 +64,9 @@
                 r_rdPtr   <= 0;
                 r_count   <= 0;
 
+                r_full    <= 1'b0;
+                r_empty   <= 1'b1;
+
                 o_rdData  <= 8'd0;
 
         end else begin
@@ -77,6 +87,9 @@
 
                                 r_count <= r_count + 1'b1;
 
+                                r_full  <= (r_count == FIFO_DEPTH - 1);
+                                r_empty <= 1'b0;
+
                         end
 
 
@@ -92,6 +105,9 @@
 
                                 r_count <= r_count - 1'b1;
 
+                                r_full  <= 1'b0;
+                                r_empty <= (r_count == 1);
+
                         end
 
 
@@ -131,4 +147,15 @@
 end
 
 
+// Simulation-only invariant check: registered flags must match r_count
+// synopsys translate_off
+always @(posedge clk) begin
+        if (rst_n && ((r_full  !== (r_count == FIFO_DEPTH)) ||
+                      (r_empty !== (r_count == 0))))
+                $display("FAIL: FIFO FLAG mismatch [%m] count=%0d full=%b empty=%b @%0t",
+                         r_count, r_full, r_empty, $time);
+end
+// synopsys translate_on
+
+
 endmodule
