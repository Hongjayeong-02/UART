+                        r_mem[k] <= i_wrData;
 end
 
 always @(posedge clk or negedge rst_n) begin
         if (!rst_n) begin
 
                 r_wrPtr   <= 0;
+                r_wrSel   <= {{(FIFO_DEPTH-1){1'b0}}, 1'b1};
